# Copy this file to .env. Never commit .env.
#
# There is no Gemini API key here any more: AI features go through the PocketBudz backend,
# which holds the key (see backend/.env.example). The app only needs to know where the
# backend is.

# Household mode and AI (the web client ID is public, not a secret)
# Google Cloud Console > APIs & Services > Credentials > Web application client
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Android emulator reaches your computer at 10.0.2.2. On a real phone use your computer's LAN IP.
# Release builds must use https:// (Android blocks plain http in release).
API_BASE_URL=http://10.0.2.2:3000
